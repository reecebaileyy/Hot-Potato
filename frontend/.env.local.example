# Copy to .env.local and fill in. All of these are inlined into the client bundle at build time,
# so never put secrets here.

# Privy app id from https://dashboard.privy.io. Enables email / social login and embedded wallets.
# Leave empty to use injected browser wallets only (fine for local development).
NEXT_PUBLIC_PRIVY_APP_ID=

# Which chain to use: robinhood (mainnet, 4663), robinhoodTestnet (46630) or hardhat (local 31337).
# Defaults to robinhoodTestnet.
NEXT_PUBLIC_CHAIN=robinhoodTestnet

# Optional RPC override. Defaults to the chain's public RPC:
#   robinhood         https://rpc.mainnet.chain.robinhood.com
#   robinhoodTestnet  https://rpc.testnet.chain.robinhood.com
#   hardhat           http://127.0.0.1:8545
NEXT_PUBLIC_RPC_URL=

# Deployed Game contract address (required). For local dev it is "HotPotato#Game" in
# backend/ignition/deployments/chain-31337/deployed_addresses.json after `npm run deploy:local`.
NEXT_PUBLIC_GAME_ADDRESS=
