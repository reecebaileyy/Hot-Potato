# Deployer / owner key (never commit the real one)
DEPLOYER_PRIVATE_KEY=0x...

# Robinhood Chain RPCs (public endpoints; Alchemy/QuickNode also work)
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional: override the Game address the scripts talk to (defaults to the Ignition deployment)
# GAME_ADDRESS=0x...

# Optional: path to a local solc 0.8.28 binary if binaries.soliditylang.org is unreachable
# SOLC_PATH=/usr/local/bin/solc

# Keeper poll interval in ms
# KEEPER_POLL_MS=3000
